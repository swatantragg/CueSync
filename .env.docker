# ── CueSync Docker environment template ──────────────────────────────────────
# Give THIS file to the deployment manager.
# Fill in the 3 marked values, then run: ./run.sh
#
# Two ways to configure the database:
#   A) Use the built-in Docker Postgres container (default, good for testing)
#   B) Use a hosted DB like Neon/Supabase (for production — uncomment section B)

# ── A) Built-in Docker Postgres (default) ────────────────────────────────────
POSTGRES_USER=cuesync
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD
POSTGRES_DB=cuesync

# Redis for token blacklist (required for proper logout across all gunicorn workers)
# docker compose starts a redis container automatically — leave this as-is
REDIS_URL=redis://redis:6379/0

# Security
ALLOW_PUBLIC_SIGNUP=true
MAX_BODY_SIZE_MB=10

# ── B) Hosted database (Neon / Supabase / RDS) ───────────────────────────────
# Uncomment these two lines and fill in your hosted DB URL.
# Also remove the 'db' service from docker-compose.yml when using a hosted DB.
# DATABASE_URL=postgresql+asyncpg://user:pass@your-db-host:5432/cuesync
# SYNC_DATABASE_URL=postgresql+psycopg://user:pass@your-db-host:5432/cuesync

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_256BIT_RANDOM_HEX

# ── Token lifetimes ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local Docker testing: http://localhost
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost

# ── Frontend port on host machine ─────────────────────────────────────────────
FRONTEND_PORT=80
