# ── A) Built-in Docker Postgres (default) ────────────────────────────────────
POSTGRES_USER=cuesync
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD
POSTGRES_DB=cuesync

# Redis for token blacklist (required for proper logout across all gunicorn workers)
# docker compose starts a redis container automatically — leave this as-is
REDIS_URL=redis://redis:6379/0

# Security
MAX_BODY_SIZE_MB=10

# ── B) Hosted database (Neon / Supabase / RDS) ───────────────────────────────
# Uncomment these two lines and fill in your hosted DB URL.
# Also remove the 'db' service from docker-compose.yml when using a hosted DB.
DATABASE_URL=your_database_url
SYNC_DATABASE_URL=your_sync_database_url


# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_256BIT_RANDOM_HEX

# ── Token lifetimes ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local Docker testing: http://localhost
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost

# ── Frontend port on host machine ─────────────────────────────────────────────
FRONTEND_PORT=80

# Client Gmail connections (Google OAuth) — fill in; see backend/.env.example
FRONTEND_URL=http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/mail/oauth/callback
MAIL_TOKEN_KEY=

# ── Weekly email reports (Brevo) — every week last week's numbers go to each editor, Work Delegator, reviewer, admin ──
# API key: Brevo → SMTP & API → API Keys. Sender: verified in Brevo → Senders, Domains & Dedicated IPs.
# Brevo can't authenticate a gmail.com sender, so use an address on your own domain; BREVO_REPLY_TO can still be the admin's Gmail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CueSync Reports
BREVO_REPLY_TO=
# Set to true on the production server only: the email links use this server's FRONTEND_URL.
REPORT_ENABLED=false
# When to send; change these and restart the backend. Reports always cover the last full Monday–Sunday week.
REPORT_DAY=monday
REPORT_TIME=09:00
REPORT_TIMEZONE=Asia/Kolkata
