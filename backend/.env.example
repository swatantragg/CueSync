APP_NAME=CueSync
APP_ENV=development
DEBUG=true

# Postgres
POSTGRES_USER=cuesync
POSTGRES_PASSWORD=cuesync_pass
POSTGRES_DB=cuesync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cuesync:cuesync_pass@localhost:5432/cuesync
SYNC_DATABASE_URL=postgresql+psycopg://cuesync:cuesync_pass@localhost:5432/cuesync

# JWT
JWT_SECRET=change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Client Gmail connections (Google OAuth) — Clients tab → Connect Gmail
# Servers that share one database must use the same GOOGLE_CLIENT_ID/SECRET and MAIL_TOKEN_KEY.
# FRONTEND_URL: where people open CueSync (the Google sign-in popup reports back to it)
FRONTEND_URL=http://localhost:5173
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that OAuth client exactly
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mail/oauth/callback
# Encrypts stored Gmail refresh tokens. Generate once and keep it; changing it disconnects every mailbox:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_TOKEN_KEY=

# ── Weekly email reports (Brevo) — every week last week's numbers go to each editor, Work Delegator, reviewer, admin ──
# API key: Brevo → SMTP & API → API Keys. Sender: verified in Brevo → Senders, Domains & Dedicated IPs.
# Brevo can't authenticate a gmail.com sender, so use an address on your own domain; BREVO_REPLY_TO can still be the admin's Gmail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CueSync Reports
BREVO_REPLY_TO=
# Set to true on the production server only: the email links use this server's FRONTEND_URL.
REPORT_ENABLED=false
# When to send; change these and restart the backend. Reports always cover the last full Monday–Sunday week.
REPORT_DAY=monday
REPORT_TIME=09:00
REPORT_TIMEZONE=Asia/Kolkata
