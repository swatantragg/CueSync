APP_NAME=CueSync
APP_ENV=development
DEBUG=true

# Postgres
POSTGRES_USER=cuesync
POSTGRES_PASSWORD=cuesync_pass
POSTGRES_DB=cuesync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cuesync:cuesync_pass@localhost:5432/cuesync
SYNC_DATABASE_URL=postgresql+psycopg://cuesync:cuesync_pass@localhost:5432/cuesync

# JWT
JWT_SECRET=change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
